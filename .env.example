# Only needed to run the seeding scripts in scripts/ — the browser app never reads this file.
# The service-role key bypasses row-level security. Never commit it, never ship it to a client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# The Gemini key is NOT used by the browser. It is set as an Edge Function secret:
#   supabase secrets set GEMINI_API_KEY=your-key
GEMINI_API_KEY=your-gemini-key
